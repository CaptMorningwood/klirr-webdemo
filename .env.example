# Browser-safe Clerk key. Use a Development instance locally and in non-production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Server-only Clerk keys. Never prefix secret values with VITE_.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Comma-separated exact origins accepted by server-side Clerk verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://tst.example.invalid

# Server-only Supabase identity persistence. Never expose the service-role key.
SUPABASE_URL=https://example.invalid
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Existing optional AI integration; server-only.
OPENAI_API_KEY=REPLACE_ME
